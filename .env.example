# FOLIO — variables de entorno. Copia este archivo a `.env` y llena los valores.
# Las que llevan prefijo VITE_ se incrustan en el bundle del navegador (son públicas);
# las demás son SOLO de servidor y NUNCA deben llevar prefijo VITE_.

# ── Cliente + servidor ──────────────────────────────────────────────────────

# URL del proyecto Supabase (Project Settings → API). Pública. La usan el cliente,
# las funciones api/*, server.js (dev) y el job de Python.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Key "anon"/public de Supabase (Project Settings → API). Pública; la seguridad la da RLS.
# Las funciones api/* la usan junto con el JWT del usuario para validar la sesión.
VITE_SUPABASE_ANON_KEY=eyJ...

# (Opcional) ID de afiliado de Buscalibre para los links de compra. Si se omite, App.jsx
# usa un valor por defecto.
VITE_BUSCALIBRE_AFFILIATE_ID=

# ── Solo servidor (Vercel env vars + .env local) ────────────────────────────

# API key de Anthropic (https://console.anthropic.com). La usa el proxy /api/anthropic
# (api/anthropic.js en producción, server.js en local). Sin prefijo VITE_: jamás al navegador.
ANTHROPIC_API_KEY=sk-ant-...

# Clave de bypass del proxy Anthropic: quien mande el header `x-admin-key` con este valor
# se salta la validación de JWT y el rate limit. Usa un valor largo y aleatorio.
ADMIN_KEY=

# (Opcional) API key de Google Books. Sube la cuota de /api/books; funciona sin ella.
# Scripts como scripts/generate-500-books.js también la leen.
GOOGLE_BOOKS_API_KEY=

# (Opcional, solo dev) Puerto del proxy local server.js. Por defecto 3001.
PORT=3001

# ── Scripts / jobs (NO van a Vercel ni al navegador) ────────────────────────

# service_role de Supabase (Project Settings → API). Salta RLS: solo para el job de
# entrenamiento (GitHub Actions secret) y scripts de seed como src/scripts/seed-books.js.
# Jamás en Vercel ni con prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# (Solo scripts/generate-500-books.js) key secreta de Supabase para escribir el catálogo.
SUPABASE_SECRET_KEY=
